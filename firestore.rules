rules_version = '2';
// HeavenDigital — owner is claimed once from the admin panel and stored in settings/store.adminUid.
// Bootstrap: while settings/store has no adminUid, any signed-in user may claim it (first come, first served).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/settings/store)
        && get(/databases/$(database)/documents/settings/store).data.adminUid == request.auth.uid;
    }
    function ownerless() {
      return request.auth != null
        && ( !exists(/databases/$(database)/documents/settings/store)
             || !("adminUid" in get(/databases/$(database)/documents/settings/store).data) );
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    function maybeShortString(d, key, max) {
      return !(key in d) || d[key] == null || shortString(d[key], max);
    }
    function validWebsiteOrderCreate(oid) {
      let d = request.resource.data;
      return oid.matches('^HD-[A-Z0-9]{3,8}$')
        && d.oid == oid
        && d.keys().hasOnly(['uid', 'guest', 'items', 'total', 'oid', 'ts', 'updatedAt', 'status', 'source', 'refBy', 'coupon', 'discount', 'refOff', 'checkoutAction', 'contactProvided'])
        && d.source == 'website'
        && d.status == 'pending'
        && d.contactProvided == true
        && d.guest is bool
        && shortString(d.uid, 100)
        && (request.auth == null || d.uid == request.auth.uid || d.uid == 'guest')
        && d.items is list
        && d.items.size() > 0
        && d.items.size() <= 25
        && d.total is number
        && d.total >= 0
        && d.total <= 500000
        && d.ts is number
        && d.updatedAt is number
        && (d.refBy == null || shortString(d.refBy, 40))
        && (d.coupon == null || shortString(d.coupon, 40))
        && d.discount is number
        && d.refOff is number
        && shortString(d.checkoutAction, 40);
    }
    function validOrderContactCreate(oid) {
      let d = request.resource.data;
      return oid.matches('^HD-[A-Z0-9]{3,8}$')
        && d.oid == oid
        && d.keys().hasOnly(['oid', 'name', 'wa', 'email', 'ts', 'updatedAt', 'source', 'checkoutAction'])
        && shortString(d.name, 80)
        && d.name.size() >= 2
        && shortString(d.wa, 15)
        && d.wa.matches('^[0-9]{10,15}$')
        && maybeShortString(d, 'email', 120)
        && d.ts is number
        && d.updatedAt is number
        && d.source == 'website'
        && shortString(d.checkoutAction, 40);
    }

    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow create: if isAdmin() || ownerless();
      allow update: if isAdmin() || ownerless();
      allow delete: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Customers may maintain contact/preferences, but only the owner can record redeemed
      // or manually adjusted loyalty points.
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['pointsRedeemed', 'pointsAdjusted']);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['pointsRedeemed', 'pointsAdjusted']));
      allow delete: if false;
    }
    match /refcodes/{code} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /orders/{oid} {
      allow get: if true; // single-order tracking by random ID (status + items only)
      // Customer account queries must constrain uid to the signed-in user's UID.
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // Public website checkout creates a limited, non-sensitive order document.
      // Buyer name/WhatsApp/email are written to /orderContacts/{oid}, which only the owner can read.
      allow create: if isAdmin() || validWebsiteOrderCreate(oid);
      allow update, delete: if isAdmin();
    }
    match /orderContacts/{oid} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validOrderContactCreate(oid);
    }
  }
}
